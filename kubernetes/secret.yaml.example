# Template only. Copy to secret.yaml (git-ignored), fill in a real password, then:
#   kubectl apply -f kubernetes/secret.yaml
# Or create it without a file:
#   kubectl create secret generic faraja-secret -n faraja \
#     --from-literal=POSTGRES_USER=postgres \
#     --from-literal=POSTGRES_PASSWORD='<password>' \
#     --from-literal=DATABASE_URL='postgresql+psycopg://postgres:<password>@database:5432/faraja'
apiVersion: v1
kind: Secret
metadata:
  name: faraja-secret
  namespace: faraja
type: Opaque
stringData:
  POSTGRES_USER: postgres
  POSTGRES_PASSWORD: change-me
  DATABASE_URL: postgresql+psycopg://postgres:change-me@database:5432/faraja
